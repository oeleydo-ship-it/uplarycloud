APP_NAME="Uplary Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# When true, skips console email verification (overrides Superadmin General Settings).
DISABLE_EMAIL_VERIFICATION=false

BILLING_DRIVER=fake
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the longest Horizon worker timeout (1260 seconds).
REDIS_QUEUE_RETRY_AFTER=1320
# Auto re-dispatch DB-queued deploys with no Redis job after this many seconds
ORPHANED_DEPLOYMENT_GRACE_SECONDS=45

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Superadmin Platform Services controls (Supervisor-managed production processes)
PLATFORM_SERVICE_CONTROL_ENABLED=true
PLATFORM_SUPERVISORCTL_PATH=supervisorctl
PLATFORM_SUPERVISORCTL_USE_SUDO=false
PLATFORM_SUDO_PATH=sudo
PLATFORM_SERVICE_CONTROL_TIMEOUT=10
PLATFORM_HORIZON_PROGRAM=upentra-horizon
PLATFORM_REVERB_PROGRAM=upentra-reverb

# Use "ssh" for live server connection pre-checks and provisioning via phpseclib.
# Use "fake" only for local demos / PHPUnit (simulated 4 CPU / 8 GB / 160 GB).
INFRASTRUCTURE_DRIVER=ssh
MANAGED_INFRASTRUCTURE_DRIVER=fake
# Use "system" for live A/AAAA lookups. "fake" only echoes expected_value for *.example.com / *.test in demos.
DNS_DRIVER=system
TRAEFIK_IMAGE=traefik:v3.6
TRAEFIK_NETWORK=uplary-proxy
TRAEFIK_CONTAINER=uplary-traefik
TRAEFIK_DYNAMIC_PATH=/opt/uplary/traefik/dynamic
ACME_EMAIL=admin@example.com
SSL_RENEW_BEFORE_DAYS=30
